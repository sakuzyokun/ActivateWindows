<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- UI Strings -->
    <sys:String x:Key="AppTitle">Activate Windows - 設定</sys:String>
    <sys:String x:Key="HeaderTitle">Activate Windows</sys:String>
    <sys:String x:Key="HeaderSubtitle">認証済みでも、あのウォーターマークを表示するアプリ。</sys:String>

    <!-- Display Text Group -->
    <sys:String x:Key="GroupText">表示テキスト</sys:String>
    <sys:String x:Key="Line1">1行目</sys:String>
    <sys:String x:Key="Line2">2行目</sys:String>

    <!-- Position Group -->
    <sys:String x:Key="GroupPosition">位置</sys:String>
    <sys:String x:Key="PosPreset">配置プリセット</sys:String>
    <sys:String x:Key="PosBottomRight">右下</sys:String>
    <sys:String x:Key="PosBottomLeft">左下</sys:String>
    <sys:String x:Key="PosTopRight">右上</sys:String>
    <sys:String x:Key="PosTopLeft">左上</sys:String>
    <sys:String x:Key="PosCenter">中央</sys:String>
    <sys:String x:Key="PosCustom">カスタム座標</sys:String>
    <sys:String x:Key="AllMonitors">すべてのモニターに表示（オフなら主モニターのみ）</sys:String>
    <sys:String x:Key="CustomPosDesc">カスタム座標は物理ピクセル単位で、主モニターの左上が (0, 0)。マルチモニターでは仮想デスクトップ座標（副モニターの配置によっては負の値もある）。カスタムのときは 1 枚だけ表示し、画面の拡大率に関係なく指定したピクセル位置に文字の左上が来る。</sys:String>

    <!-- Appearance Group -->
    <sys:String x:Key="GroupAppearance">見た目</sys:String>
    <sys:String x:Key="TextColor">文字色（#RRGGBB）</sys:String>
    <sys:String x:Key="ResetColor">白に戻す</sys:String>
    <sys:String x:Key="Opacity">透明度</sys:String>
    <sys:String x:Key="FontSize">文字サイズ</sys:String>

    <!-- Behavior Group -->
    <sys:String x:Key="GroupBehavior">動作</sys:String>
    <sys:String x:Key="ClickThrough">クリックを背後のアプリに通す（おすすめ）</sys:String>
    <sys:String x:Key="Topmost">常に最前面に表示</sys:String>
    <sys:String x:Key="ExitWithSettings">設定画面を閉じたらアプリごと終了（オフならトレイに常駐）</sys:String>
    <sys:String x:Key="Disclaimer">※ 表示は通常の透明ウィンドウで実現。Windows本体のライセンス状態は変更しない。トレイのアイコンから設定の再表示・ウォーターマークの切り替え・終了ができる。</sys:String>

    <!-- Footer Buttons & Status -->
    <sys:String x:Key="StatusReady">準備完了</sys:String>
    <sys:String x:Key="StatusHide">ウォーターマークを終了したよ</sys:String>
    <sys:String x:Key="StatusShow">ウォーターマークを表示したよ</sys:String>
    <sys:String x:Key="StatusPreview">プレビュー表示中</sys:String>
    <sys:String x:Key="StatusApplied">設定を適用したよ！</sys:String>
    <sys:String x:Key="BtnClose">表示を終了</sys:String>
    <sys:String x:Key="BtnPreview">プレビュー表示</sys:String>
    <sys:String x:Key="BtnApply">設定を適用</sys:String>
</ResourceDictionary>